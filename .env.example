# Copy to .env (git-ignored). Every value here is a secret or machine-local.
TEMPO_DATABASE_URL=postgresql://tempo:tempo@localhost:5433/tempo
TEMPO_AUTHOR_SALT=change-me-long-random-string
GITHUB_TOKEN=
# Optional shared bearer token the OTLP receiver requires when set:
TEMPO_OTLP_TOKEN=
TEMPO_ORG_UNIT=default
